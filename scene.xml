<mujoco model="ur3_pick_workcell">
  <!--
    UR3 vision-guided pick workcell (41014 AT4, Track B)
    UR3 kinematics follow the official UR3 standard DH parameters:
      d1 = 0.1519   a2 = -0.24365   a3 = -0.21325
      d4 = 0.11235  d5 =  0.08535   d6 =  0.0819
      alpha = [pi/2, 0, 0, pi/2, -pi/2, 0]
    Each arm body's frame is the DH frame {i-1}; its hinge rotates about local z.
    The next body sits at Tz(d_i) * Tx(a_i) * Rx(alpha_i), so MuJoCo's zero pose
    equals the DH zero pose and Robotics Toolbox's UR3 can validate the FK.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.5" armature="0.05"/>
    <geom contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
    <default class="link">
      <geom type="capsule" size="0.03" rgba="0.75 0.78 0.82 1"/>
    </default>
    <default class="joint_vis">
      <geom type="cylinder" size="0.04 0.045" rgba="0.15 0.35 0.65 1" contype="0" conaffinity="0" mass="0"/>
    </default>
    <default class="finger">
      <geom type="box" size="0.008 0.005 0.025" rgba="0.2 0.2 0.2 1" friction="1.5 0.01 0.001"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid"/>

    <!-- Table: top surface at z = 0.75 m -->
    <body name="table" pos="0.5 0 0.375">
      <geom name="table_top" type="box" size="0.4 0.6 0.375" rgba="0.6 0.45 0.3 1"/>
    </body>

    <!-- ===================== UR3 ===================== -->
    <body name="ur3_base" pos="0.2 0 0.75">
      <geom name="base_geom" type="cylinder" size="0.06 0.02" pos="0 0 0.02" mass="2.0" rgba="0.15 0.15 0.15 1"/>

      <!-- Joint 1: base rotation -->
      <body name="shoulder_link">
        <joint name="shoulder_pan" axis="0 0 1" range="-6.2832 6.2832"/>
        <geom class="joint_vis"/>
        <geom class="link" fromto="0 0 0 0 0 0.1519" mass="2.0"/>

        <!-- Joint 2: shoulder lift (d1 = 0.1519, alpha1 = pi/2) -->
        <body name="upper_arm_link" pos="0 0 0.1519" quat="0.70710678 0.70710678 0 0">
          <joint name="shoulder_lift" axis="0 0 1" range="-6.2832 6.2832"/>
          <geom class="joint_vis"/>
          <geom class="link" fromto="0 0 0 -0.24365 0 0" mass="3.42"/>

          <!-- Joint 3: elbow (a2 = -0.24365) -->
          <body name="forearm_link" pos="-0.24365 0 0">
            <joint name="elbow" axis="0 0 1" range="-3.1416 3.1416"/>
            <geom class="joint_vis"/>
            <geom class="link" fromto="0 0 0 -0.21325 0 0" size="0.025" mass="1.26"/>

            <!-- Joint 4: wrist 1 (a3 = -0.21325) -->
            <body name="wrist_1_link" pos="-0.21325 0 0">
              <joint name="wrist_1" axis="0 0 1" range="-6.2832 6.2832"/>
              <geom class="joint_vis" size="0.032 0.035"/>
              <geom class="link" fromto="0 0 0 0 0 0.11235" size="0.022" mass="0.8"/>

              <!-- Joint 5: wrist 2 (d4 = 0.11235, alpha4 = pi/2) -->
              <body name="wrist_2_link" pos="0 0 0.11235" quat="0.70710678 0.70710678 0 0">
                <joint name="wrist_2" axis="0 0 1" range="-6.2832 6.2832"/>
                <geom class="joint_vis" size="0.032 0.035"/>
                <geom class="link" fromto="0 0 0 0 0 0.08535" size="0.022" mass="0.8"/>

                <!-- Joint 6: wrist 3 (d5 = 0.08535, alpha5 = -pi/2) -->
                <body name="wrist_3_link" pos="0 0 0.08535" quat="0.70710678 -0.70710678 0 0">
                  <joint name="wrist_3" axis="0 0 1" range="-6.2832 6.2832"/>
                  <geom class="joint_vis" size="0.032 0.03"/>
                  <geom class="link" fromto="0 0 0 0 0 0.0819" size="0.02" mass="0.35"/>

                  <!-- Flange / tool frame (d6 = 0.0819). Tool axis = local +z -->
                  <body name="flange" pos="0 0 0.0819">
                    <site name="flange_site" size="0.01" rgba="1 1 0 1"/>

                    <!-- Simple parallel gripper -->
                    <geom name="palm" type="box" size="0.02 0.045 0.015" pos="0 0 0.015" mass="0.3" rgba="0.2 0.2 0.2 1"/>
                    <body name="finger_left" pos="0 0.035 0.055">
                      <joint name="finger_left" type="slide" axis="0 -1 0" range="0 0.028" damping="5" armature="0"/>
                      <geom name="finger_left_pad" class="finger" mass="0.05"/>
                    </body>
                    <body name="finger_right" pos="0 -0.035 0.055">
                      <joint name="finger_right" type="slide" axis="0 1 0" range="0 0.028" damping="5" armature="0"/>
                      <geom name="finger_right_pad" class="finger" mass="0.05"/>
                    </body>
                    <!-- Tool centre point: between the finger tips -->
                    <site name="tcp" pos="0 0 0.065" size="0.008" rgba="1 0 1 1"/>

                    <!-- Wrist RGB-D camera: beside the gripper, looking along the tool axis (+z) -->
                    <geom name="wrist_cam_body" type="box" size="0.012 0.02 0.01" pos="0.05 0 0.01" contype="0" conaffinity="0" mass="0" rgba="0.1 0.1 0.1 1"/>
                    <camera name="wrist_cam" pos="0.05 0 0.02" xyaxes="1 0 0 0 -1 0" fovy="58"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ===================== Task objects ===================== -->
    <!-- Target cube, 4 cm, free to move (position randomised per trial) -->
    <body name="target_cube" pos="0.5 0.1 0.77">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" mass="0.05" rgba="0.9 0.1 0.1 1" friction="1.5 0.01 0.001"/>
    </body>

    <!-- Drop-off zone: visual only, nothing collides with it -->
    <geom name="dropoff_zone" type="box" pos="0.45 -0.25 0.751" size="0.06 0.06 0.001"
          rgba="0.1 0.8 0.1 0.5" contype="0" conaffinity="0"/>

    <!-- Overview camera for testing and the demo video -->
    <camera name="overview" pos="1.6 0 1.6" xyaxes="0 1 0 -0.6 0 0.8"/>
  </worldbody>

  <equality>
    <!-- Fingers move together -->
    <joint joint1="finger_right" joint2="finger_left"/>
  </equality>

  <actuator>
    <!-- Arm: torque motors (Nm). Limits are the UR3 rated joint torques. -->
    <motor name="tau_shoulder_pan"  joint="shoulder_pan"  ctrlrange="-56 56"/>
    <motor name="tau_shoulder_lift" joint="shoulder_lift" ctrlrange="-56 56"/>
    <motor name="tau_elbow"         joint="elbow"         ctrlrange="-28 28"/>
    <motor name="tau_wrist_1"       joint="wrist_1"       ctrlrange="-12 12"/>
    <motor name="tau_wrist_2"       joint="wrist_2"       ctrlrange="-12 12"/>
    <motor name="tau_wrist_3"       joint="wrist_3"       ctrlrange="-12 12"/>
    <!-- Gripper: 0 = open, 0.028 = closed -->
    <position name="gripper" joint="finger_left" ctrlrange="0 0.028" kp="400" forcerange="-20 20"/>
  </actuator>

  <sensor>
    <!-- Joint encoders: positions only. Velocities are NOT measured, so the
         observer (state_estimator.py) must estimate them. Noise is added in Python. -->
    <jointpos name="enc_shoulder_pan"  joint="shoulder_pan"/>
    <jointpos name="enc_shoulder_lift" joint="shoulder_lift"/>
    <jointpos name="enc_elbow"         joint="elbow"/>
    <jointpos name="enc_wrist_1"       joint="wrist_1"/>
    <jointpos name="enc_wrist_2"       joint="wrist_2"/>
    <jointpos name="enc_wrist_3"       joint="wrist_3"/>
  </sensor>

  <keyframe>
    <!-- qpos order: 6 arm joints, 2 fingers, cube (x y z qw qx qy qz) -->
    <key name="home" qpos="2.6787 -1.7707 1.2555 -1.0637 -1.5741 0 0 0 0.5 0.1 0.77 1 0 0 0"/>
  </keyframe>
</mujoco>